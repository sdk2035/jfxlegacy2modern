          <mxGeometry x="40" y="25" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Dependencia requerida del perfil erp-low-code: Frappe (MIT), familia 15 para el ejemplo ERPNext 15. Revisiones y version_tested pendientes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="team" value="EQUIPO DE MODERNIZACIÓN&lt;br&gt;Negocio · TI · datos · QA · soporte&lt;br&gt;Perfiles y alcance aprobado&lt;br&gt;Revisión de cambios y resultados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="225" width="450" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="APP / INTERFAZ LOW-CODE&lt;br&gt;DocTypes y formularios propuestos&lt;br&gt;Migration Project / ERP Profile&lt;br&gt;Mapping Revision / Upgrade Step&lt;br&gt;Evidence Record / Support Case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="575" y="225" width="450" height="200" as="geometry" />
        </mxCell>
        <mxCell id="frappe" value="FRAPPE · RUNTIME EXTERNO&lt;br&gt;Dependencia requerida del módulo&lt;br&gt;Modelo, permisos y workflows&lt;br&gt;Exportación de app/configuración&lt;br&gt;Framework por desplegar y probar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1110" y="225" width="450" height="200" as="geometry" />
        </mxCell>
        <mxCell id="contracts" value="CONTRATOS PROPUESTOS&lt;br&gt;Planes y revisión de mapeos&lt;br&gt;Aprobaciones acotadas&lt;br&gt;Consulta de evidencias y soporte&lt;br&gt;Identidad + revisión + auditoría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="executor" value="SERVICIO erp-modernization&lt;br&gt;Valida autorización y puertas&lt;br&gt;Orquesta adaptadores versionados&lt;br&gt;Controla lotes, errores y reintentos&lt;br&gt;No implementado en este cambio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="575" y="600" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="erp" value="ADAPTADOR DESTINO → ERP&lt;br&gt;Carga por interfaces de negocio&lt;br&gt;Permisos y idempotencia&lt;br&gt;Conciliación y errores en cuarentena&lt;br&gt;Sin SQL directo desde UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1110" y="600" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#63778e;fontSize=14;" edge="1" parent="1" source="team" target="ui">
