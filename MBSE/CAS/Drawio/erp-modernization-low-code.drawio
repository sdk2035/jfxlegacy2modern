        <mxCell id="ERP-09" value="ERP-09 · Soporte&lt;br&gt;Definir incidentes, severidad, responsables, monitoreo, recuperación, formación y transferencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
