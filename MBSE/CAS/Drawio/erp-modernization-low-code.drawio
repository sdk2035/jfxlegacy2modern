        <mxCell id="a-LC-06" value="Responsable: Datos + QA&lt;br&gt;Aceptación: Artefactos e identidades reconstruibles; cambios incompatibles detectados." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
