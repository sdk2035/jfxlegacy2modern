  <diagram id="req-4" name="05 · Requisitos ERP y low-code — soporte y dependencia">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="05 · Requisitos ERP y low-code — soporte y dependencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=25;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Todos los requisitos son propuestos. Responsables por rol; tolerancias, runtimes y parámetros de servicio deben aprobarse antes del ensayo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ERP-10" value="ERP-10 · Versiones y mantenimiento&lt;br&gt;Registrar mantenimiento upstream y riesgos de cada revisión; revisar runtimes y apps separadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="205" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-ERP-10" value="Responsable: TI&lt;br&gt;Aceptación: Estado revisado antes de decidir destino; 11 y 15 no se presuponen versiones recomendadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="205" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ERP-11" value="ERP-11 · Seguridad y acceso&lt;br&gt;Preservar autorización por empresa/rol y referencias de secretos; probar rechazo y auditoría." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-ERP-11" value="Responsable: Seguridad&lt;br&gt;Aceptación: Accesos no autorizados rechazados; sin secretos en manifiestos; actor y cambios auditables." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="285" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ERP-12" value="ERP-12 · Trazabilidad&lt;br&gt;Relacionar fuente, requisito, mapeo/receta, caso, evidencia y aprobación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-ERP-12" value="Responsable: QA&lt;br&gt;Aceptación: Todos los requisitos en alcance tienen evidencia o excepción aprobada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="365" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="LC-01" value="LC-01 · Dependencia low-code&lt;br&gt;El módulo erp-low-code declara Frappe como dependencia runtime del perfil low-code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-LC-01" value="Responsable: Arquitectura&lt;br&gt;Aceptación: Manifiesto identifica repositorio, licencia, familia de versión y estado no validado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="445" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="LC-02" value="LC-02 · Configuración exportable&lt;br&gt;Versionar modelos, formularios, flujos, permisos y scripts como app/artefactos exportables." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="525" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-LC-02" value="Responsable: Low-code&lt;br&gt;Aceptación: Exportación e importación en sandbox reproducibles con revisión y procedencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="525" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="LC-03" value="LC-03 · Cambios revisables&lt;br&gt;Publicar configuraciones y scripts solo después de revisar y probar en destino." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="605" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-LC-03" value="Responsable: Low-code + QA&lt;br&gt;Aceptación: Cambios aprobados; reversión de app/configuración ensayada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="605" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="LC-04" value="LC-04 · Compatibilidad de framework&lt;br&gt;Fijar conjuntamente revisiones Frappe, ERPNext y apps del perfil." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="685" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-LC-04" value="Responsable: TI&lt;br&gt;Aceptación: Pines inmutables, runtimes y regresiones validados antes de habilitar el perfil." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="685" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="LC-05" value="LC-05 · Frontera de integración&lt;br&gt;La interfaz low-code usa contratos del servicio; no escribe directamente BD del ERP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
