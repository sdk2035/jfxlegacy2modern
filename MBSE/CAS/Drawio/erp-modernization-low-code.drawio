<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" version="28.2.5">
  <diagram id="erp-overview" name="01 · Soporte, migración ERP y low-code">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="01 · Soporte, migración ERP y low-code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=25;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Arquitectura propuesta · Ningún conector ni ejecutor ERP implementado · Rutas y dependencias sujetas a cualificación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="source" value="ERP ORIGEN&lt;br&gt;Odoo Community / ERPNext / Flectra&lt;br&gt;Dolibarr / Tryton / iDempiere&lt;br&gt;Producto + edición + revisión&lt;br&gt;Módulos, datos y procesos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="225" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="service" value="erp-modernization&lt;br&gt;Inventario, brechas y planificación&lt;br&gt;Upgrade por salto / mapeos entre ERP&lt;br&gt;Staging, conciliación y puertas&lt;br&gt;Corte, reversión y soporte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="575" y="225" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="target" value="ERP DESTINO&lt;br&gt;Revisión y runtime fijados&lt;br&gt;Interfaces de negocio validadas&lt;br&gt;Procesos, permisos y localización&lt;br&gt;Pruebas + aceptación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1110" y="225" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="lc" value="erp-low-code · OPCIONAL EN NÚCLEO&lt;br&gt;Perfil con dependencia Frappe requerida&lt;br&gt;DocTypes, formularios y workflows&lt;br&gt;Módulo especificado, no instalado&lt;br&gt;LC-01…06" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ecff;strokeColor=#8060b0;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="dep" value="DEPENDENCIAS EXTERNAS&lt;br&gt;Frappe 15: perfil low-code de ejemplo&lt;br&gt;ERPNext/Frappe/apps: fijar juntos&lt;br&gt;OpenUpgrade: solo worker Odoo&lt;br&gt;Pines y pruebas pendientes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="575" y="600" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="EVIDENCIA Y OPERACIÓN&lt;br&gt;Requisito → receta/mapeo → prueba&lt;br&gt;Saldos / stock / adjuntos / UAT&lt;br&gt;Backups y restauración ensayados&lt;br&gt;Runbook y aceptación del soporte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1110" y="600" width="450" height="210" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="adaptadores" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#63778e;fontSize=14;" edge="1" parent="1" source="source" target="service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="carga / upgrade" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#63778e;fontSize=14;" edge="1" parent="1" source="service" target="target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="depende de Frappe" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#63778e;fontSize=14;" edge="1" parent="1" source="lc" target="dep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="contratos" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#63778e;fontSize=14;" edge="1" parent="1" source="lc" target="service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="resultados" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#63778e;fontSize=14;" edge="1" parent="1" source="target" target="evidence">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Rascal MPL: análisis y reglas de código propuestos; frontends Python/XML/metadatos ERP por desarrollar.&lt;br&gt;Low-code configura y revisa; el adaptador destino conserva la semántica de negocio. Cada ruta incluye revisión de compatibilidad, datos y recuperación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=16;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="875" width="1520" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="erp-routes" name="02 · Rutas explícitas de versión y producto">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="02 · Rutas explícitas de versión y producto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=25;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="note" value="11→15 son ejemplos de planificación. Confirmar mantenimiento y versiones exactas antes de elegir destino. Los saltos son propuestas, no compatibilidad probada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="route0" value="UPGRADE ODOO COMMUNITY&lt;br&gt;11.0 → 12.0 → 13.0 → 14.0 → 15.0&lt;br&gt;OpenUpgrade por transición; cobertura de módulos y personalizaciones por comprobar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=20;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="215" width="1520" height="155" as="geometry" />
        </mxCell>
        <mxCell id="route1" value="UPGRADE ERPNEXT&lt;br&gt;11 → 12 → 13 → 14 → 15&lt;br&gt;Revisar recetas, Frappe, Bench y apps por etapa; no asumir salto directo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=20;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1520" height="155" as="geometry" />
        </mxCell>
        <mxCell id="route2" value="MIGRACIÓN ENTRE ERP&lt;br&gt;Odoo Community 11.0 → ERPNext 15&lt;br&gt;Extraer → modelo de intercambio → mapeos → carga destino. Sin upgrade Odoo previo obligatorio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=20;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="585" width="1520" height="155" as="geometry" />
        </mxCell>
        <mxCell id="gates" value="POR SALTO / LOTE · respaldo y restauración → receta/mapeo fijados → sandbox → procesos críticos → conciliación → evidencia aceptada&lt;br&gt;Si falla una puerta, detener el avance. Históricos, saldos de apertura y archivo consultable se deciden por entidad; no son intercambiables." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=18;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="815" width="1520" height="145" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="erp-low-code" name="03 · Módulo low-code y límites de dependencia">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
