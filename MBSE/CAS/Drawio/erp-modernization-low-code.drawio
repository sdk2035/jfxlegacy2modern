        </mxCell>
        <mxCell id="LC-06" value="LC-06 · Persistencia de artefactos&lt;br&gt;Conservar el historial de configuraciones, aprobaciones y evidencias tras el upgrade." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
