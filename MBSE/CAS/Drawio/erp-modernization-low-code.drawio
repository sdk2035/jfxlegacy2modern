        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#63778e;fontSize=14;" edge="1" parent="1" source="contracts" target="executor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#63778e;fontSize=14;" edge="1" parent="1" source="executor" target="erp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Artefactos low-code en Git → revisión → exportación/importación sandbox → pruebas de permisos y regresión → aprobación → despliegue&lt;br&gt;Mantener pines Frappe/ERPNext/apps, reversión e historia. Un workflow visual no reemplaza las reglas ERP, las recetas ni las pruebas de datos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=16;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="1520" height="100" as="geometry" />
        </mxCell>
