  <diagram id="req-3" name="04 · Requisitos ERP — inventario y migración">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="04 · Requisitos ERP — inventario y migración" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=25;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1520" height="65" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Todos los requisitos son propuestos. Responsables por rol; tolerancias, runtimes y parámetros de servicio deben aprobarse antes del ensayo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78220;fontColor=#172d46;fontSize=15;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ERP-01" value="ERP-01 · Inventario&lt;br&gt;Registrar producto, edición, versión exacta, módulos, código propio, datos, infraestructura y licencias." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="205" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-ERP-01" value="Responsable: TI&lt;br&gt;Aceptación: Inventario completo del alcance; exclusiones y dependencias aprobadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="205" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ERP-02" value="ERP-02 · Ruta y compatibilidad&lt;br&gt;Distinguir upgrade de producto, migración entre ERP y soporte operativo; fijar pasos y revisiones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="285" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-ERP-02" value="Responsable: Arquitectura&lt;br&gt;Aceptación: Cada paso tiene receta, matriz de módulos, runtime y revisión; ninguna ruta se etiqueta validada sin ensayo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="285" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ERP-03" value="ERP-03 · Modelo de intercambio&lt;br&gt;Versionar entidad, identidad externa, empresa, relaciones, unidades, moneda y procedencia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-ERP-03" value="Responsable: Datos&lt;br&gt;Aceptación: Mapeos explícitos; claves duplicadas y referencias huérfanas detectadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="365" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ERP-04" value="ERP-04 · Equivalencia de negocio&lt;br&gt;Mapear procesos, permisos, personalizaciones y localización del origen al destino." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-ERP-04" value="Responsable: Negocio&lt;br&gt;Aceptación: Escenarios críticos aceptados; brechas y excepciones documentadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="445" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ERP-05" value="ERP-05 · Upgrade escalonado&lt;br&gt;Planificar 11→12→13→14→15 con validación y respaldo por salto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="525" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-ERP-05" value="Responsable: Migración&lt;br&gt;Aceptación: Arranque, pruebas críticas y conciliación pasan en cada salto; fallos detienen el avance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="525" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ERP-06" value="ERP-06 · Importación entre productos&lt;br&gt;Usar adaptadores e interfaces de negocio del ERP destino y orden de dependencias." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="605" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-ERP-06" value="Responsable: Integraciones&lt;br&gt;Aceptación: Ensayo de carga aceptado; repetición idempotente; errores en cuarentena." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="605" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ERP-07" value="ERP-07 · Conciliación&lt;br&gt;Comparar conteos, saldos, existencias, impuestos, monedas, series/lotes y adjuntos según alcance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="685" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a-ERP-07" value="Responsable: Datos + negocio&lt;br&gt;Aceptación: Tolerancias acordadas antes del ensayo; diferencias explicadas y aprobadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="815" y="685" width="745" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ERP-08" value="ERP-08 · Corte y reversión&lt;br&gt;Definir congelación, delta final, respaldo consistente, restauración y retorno al origen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#4276b8;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="765" width="745" height="72" as="geometry" />
        </mxCell>
