        </mxCell>
        <mxCell id="a-LC-05" value="Responsable: Integraciones&lt;br&gt;Aceptación: Pruebas de contratos y permisos pasan; importaciones usan adaptador destino." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#388563;fontColor=#172d46;fontSize=13;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
